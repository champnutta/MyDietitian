{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "services/backend",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": {
    "site": "mydietitian",
    "public": "apps/liff/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/settings",
        "destination": "/settings.html"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/meal-edit",
        "destination": "/meal-edit.html"
      },
      {
        "source": "/settings/meal-edit",
        "destination": "/meal-edit.html"
      },
      {
        "source": "/meal-delete",
        "destination": "/meal-delete.html"
      },
      {
        "source": "/settings/meal-delete",
        "destination": "/meal-delete.html"
      },
      {
        "source": "/exercise-delete",
        "destination": "/exercise-delete.html"
      },
      {
        "source": "/settings/exercise-delete",
        "destination": "/exercise-delete.html"
      },
      {
        "source": "/leftover",
        "destination": "/leftover.html"
      },
      {
        "source": "/settings/leftover",
        "destination": "/leftover.html"
      },
      {
        "source": "/meal-log",
        "destination": "/meal-log.html"
      },
      {
        "source": "/settings/meal-log",
        "destination": "/meal-log.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/@(settings|dashboard|meal-edit|meal-delete|exercise-delete|leftover|meal-log|admin)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/settings/@(meal-edit|meal-delete|exercise-delete|leftover|meal-log)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ]
  }
}
